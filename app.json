{
  "expo": {
    "name": "食事サポート",
    "slug": "food-health-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodhealthapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodhealthapp.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "食事の写真撮影とバーコード読み取りのためにカメラを使用します",
        "NSPhotoLibraryUsageDescription": "食事や健診結果の写真を選択するためにフォトライブラリを使用します",
        "NSHealthShareUsageDescription": "歩数、心拍数、睡眠データを取得して健康管理に活用します",
        "NSHealthUpdateUsageDescription": "HealthKitにデータを記録します",
        "NSSpeechRecognitionUsageDescription": "音声を認識して食事を記録します",
        "NSMicrophoneUsageDescription": "食事記録の音声入力にマイクを使用します",
        "NSLocationWhenInUseUsageDescription": "現在地に合わせて地域情報を設定するために位置情報を使用します",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_NUTRITION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "食事の写真撮影とバーコード読み取りのためにカメラを使用します",
          "microphonePermission": "食事記録の音声入力にマイクを使用します"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "食事や健診結果の写真を選択するためにフォトライブラリを使用します"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地に合わせて地域情報を設定するために位置情報を使用します"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
