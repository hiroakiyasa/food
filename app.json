{
  "expo": {
    "name": "食事サポート",
    "slug": "food-health-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodhealthapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodhealthapp.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "歩数、心拍数、睡眠データを取得して健康管理に活用します",
        "NSHealthUpdateUsageDescription": "HealthKitにデータを記録します",
        "NSSpeechRecognitionUsageDescription": "音声を認識して食事を記録します",
        "NSMicrophoneUsageDescription": "食事記録の音声入力にマイクを使用します",
        "NSLocationWhenInUseUsageDescription": "現在地に合わせて地域情報を設定するために位置情報を使用します"
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#10B981"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地に合わせて地域情報を設定するために位置情報を使用します"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
