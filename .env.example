# ローカルUI開発はモックバックエンドで開始できます。
EXPO_PUBLIC_USE_MOCK=true

# 実バックエンドへ接続する場合のみ、公開可能なSupabase URLとanon keyを設定します。
# `sb_secret_` またはservice-role keyはクライアントアプリに設定しないでください。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 食品画像検索を有効にする場合のみ設定します。
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=

# RevenueCat の公開SDKキー（本番ビルドで必須。secret keyではありません）。
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
