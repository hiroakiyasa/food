# Server-side only. Never copy these values into EXPO_PUBLIC_* variables.

# AI画像解析 (analyze-food-image)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional model overrides. The function falls back to gemini-3.1-flash-lite.
GEMINI_FOOD_MODEL=gemini-3.1-flash-lite

# AIアドバイス/食事プラン (health-check-advice, generate-meal-plan)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# RevenueCat Webhook (revenuecat-webhook)
# REQUIRED in production — the webhook rejects ALL requests when unset
# (fail-closed). Set the same value in the RevenueCat dashboard's webhook
# Authorization header as `Bearer <value>`.
REVENUECAT_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase platform.
